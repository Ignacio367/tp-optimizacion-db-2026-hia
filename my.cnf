# Configuración del servidor MySQL (se monta desde docker-compose.yml).
[mysqld]

# Caché en RAM de páginas de datos e índices. Por defecto son 128M.
# Descomentar para que los tres midan con la misma memoria.
# En el punto 15 se compara con distintos tamaños (128M contra 1G, por ejemplo).
# innodb_buffer_pool_size = 1G